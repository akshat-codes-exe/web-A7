* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {

    font-family: Arial, sans-serif;

    background-color: #eeeeee;

    color: #222;

    padding-top: 30px;
}



body > h1 {

    text-align: center;

    font-size: 45px;

    margin-bottom: 10px;
}

.intro {

    text-align: center;

    color: #666;

    margin-bottom: 40px;
}




section {

    width: 90%;

    max-width: 900px;

    margin: 40px auto;

    padding: 35px;

    background-color: white;

    border-radius: 10px;

    box-shadow: 0 5px 15px #0002;
}

section h2 {

    text-align: center;

    margin-bottom: 30px;

    font-size: 30px;
}


.boxes {

    display: flex;

    justify-content: center;

    align-items: center;

    gap: 30px;

    flex-wrap: wrap;
}



.border-image-box {

    width: 400px;

    margin: auto;

    padding: 35px;

    text-align: center;

    border: 15px solid transparent;

    border-image:
        linear-gradient(
            45deg,
            red,
            blue
        ) 1;
}

.border-image-box h3 {

    margin-bottom: 10px;
}


.box {

    width: 300px;

    height: 150px;

    display: flex;

    justify-content: center;

    align-items: center;

    color: white;

    font-size: 20px;

    font-weight: bold;

    border-radius: 10px;
}


.linear {

    background:
        linear-gradient(
            to right,
            red,
            orange,
            yellow
        );
}



.radial {

    background:
        radial-gradient(
            circle,
            yellow,
            orange,
            red
        );
}



.text-box {

    text-align: center;
}

.shadow {

    font-size: 45px;

    text-shadow:
        4px 4px 5px gray;

    margin-bottom: 30px;
}


.spacing {

    font-size: 30px;

    letter-spacing: 10px;

    margin-bottom: 30px;
}


.uppercase {

    font-size: 30px;

    text-transform: uppercase;
}



.transform-box {

    width: 150px;

    height: 150px;

    display: flex;

    justify-content: center;

    align-items: center;

    background-color: #673ab7;

    color: white;

    border-radius: 10px;

    font-weight: bold;

    cursor: pointer;
}



.translate:hover {

    transform: translate(50px, -20px);
}



.rotate:hover {

    transform: rotate(30deg);
}



.scale:hover {

    transform: scale(1.3);
}



.skew:hover {

    transform: skew(20deg);
}



.instruction {

    text-align: center;

    color: #666;

    margin-bottom: 20px;
}


.transition-box {

    width: 180px;

    height: 100px;

    margin: auto;

    display: flex;

    justify-content: center;

    align-items: center;

    background-color: #3498db;

    color: white;

    border-radius: 10px;

    cursor: pointer;

    transition:
        transform 0.5s ease,
        background-color 0.5s ease,
        box-shadow 0.5s ease;
}


.transition-box:hover {

    transform: scale(1.2);

    background-color: #e74c3c;

    box-shadow:
        0 10px 20px #0005;
}



.timing-boxes {

    display: flex;

    flex-direction: column;

    gap: 15px;
}


.timing {

    width: 150px;

    padding: 15px;

    background-color: #9b59b6;

    color: white;

    text-align: center;

    border-radius: 5px;

    cursor: pointer;
}


/* Ease */

.ease {

    transition:
        width 2s ease;
}


/* Linear */

.linear-timing {

    transition:
        width 2s linear;
}


/* Ease In */

.ease-in {

    transition:
        width 2s ease-in;
}


/* Ease Out */

.ease-out {

    transition:
        width 2s ease-out;
}



.timing-boxes:hover .timing {

    width: 90%;
}




.animation-area {

    height: 120px;

    background-color: #eeeeee;

    border-radius: 10px;

    position: relative;

    overflow: hidden;
}


.moving-box {

    width: 100px;

    height: 70px;

    background-color: #2ecc71;

    color: white;

    display: flex;

    justify-content: center;

    align-items: center;

    border-radius: 8px;

    position: absolute;

    top: 25px;

    left: 0;

    animation:
        move 3s linear infinite;
}


/* Animation */

@keyframes move {

    from {

        left: 0;
    }

    to {

        left: calc(100% - 100px);
    }

}



.bounce-area {

    height: 220px;

    display: flex;

    justify-content: center;

    align-items: flex-start;
}


.ball {

    width: 60px;

    height: 60px;

    background-color: #e74c3c;

    border-radius: 50%;

    animation:
        bounce 1s ease-in-out infinite;
}


@keyframes bounce {

    0% {

        transform: translateY(0);
    }

    50% {

        transform: translateY(130px);
    }

    100% {

        transform: translateY(0);
    }

}



footer {

    margin-top: 50px;

    padding: 25px;

    text-align: center;

    background-color: #222;

    color: white;
}
